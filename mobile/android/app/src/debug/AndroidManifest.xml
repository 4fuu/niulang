<?xml version="1.0" encoding="utf-8"?>
<!--
    The full-device tunnel, debug builds only.

    It is kept as the one thing that drives the Go packet stack end to end on a
    real Android device: TUN file descriptor in, TCP and UDP flows out. The
    released app declares none of this — no BIND_VPN_SERVICE, no VpnService
    intent filter — so routing policy stays with whichever client the user
    already trusts with it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".QueqiaoVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
        </service>
    </application>
</manifest>
