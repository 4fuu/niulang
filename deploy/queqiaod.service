[Unit]
Description=queqiao performance-enhancing proxy
Documentation=https://github.com/bojieli/queqiao
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=queqiao
Group=queqiao
# Put whitespace-separated server flags in /etc/queqiao/queqiaod.env as:
# QUEQIAOD_ARGS=--state /var/lib/queqiao/provider --listen :12540 ...
EnvironmentFile=/etc/queqiao/queqiaod.env
# The shared runtime logger resolves this to /var/log/queqiao/server.log,
# rotates it at 32 MiB, and retains five backups. stderr remains available in
# journald as an independent emergency/debugging surface.
Environment=QUEQIAO_LOG_DIR=/var/log/queqiao
ExecStart=/usr/local/bin/queqiaod server $QUEQIAOD_ARGS
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
# A gateway listening on 443 is bound by an unprivileged account, which needs
# this capability granted at exec: NoNewPrivileges blocks acquiring it any
# other way. Bounding the set to the single capability the service can use
# also removes every other capability from its reach.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/queqiao /var/log/queqiao
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
