[Unit]
Description=niulang experimental adaptive PEP (development instance)
Documentation=https://github.com/4fuu/niulang
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=niulang
Group=niulang
ExecStart=/usr/local/bin/niulangd server --state /var/lib/niulang/provider --listen :12443 --transport auto --max-sessions 512 --metrics-listen 127.0.0.1:19090 --log-level info --log-format json --log-file /var/log/niulang/server-dev.log --telemetry-log-interval 5s
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
# A gateway listening on 443 is bound by an unprivileged account, which needs
# this capability granted at exec: NoNewPrivileges blocks acquiring it any
# other way. Bounding the set to the single capability the service can use
# also removes every other capability from its reach.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/niulang /var/log/niulang
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
