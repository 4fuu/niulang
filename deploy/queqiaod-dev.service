[Unit]
Description=queqiao experimental adaptive PEP (development instance)
Documentation=https://github.com/bojieli/queqiao
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=queqiao
Group=queqiao
ExecStart=/usr/local/bin/queqiaod --mode server --listen :12443 --transport auto --secret-file /etc/queqiao/session.secret --tls-cert /etc/queqiao/fullchain.pem --tls-key /etc/queqiao/privkey.pem --max-sessions 512 --metrics-listen 127.0.0.1:19090 --log-level info --json-logs
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/queqiao /var/log/queqiao
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
