[Unit]
Description=wanopt experimental adaptive PEP (development instance)
Documentation=https://github.com/icourses-dev/wanopt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wanopt
Group=wanopt
ExecStart=/usr/local/bin/wanoptd --mode server --listen :12443 --transport auto --secret-file /etc/wanopt/session.secret --tls-cert /etc/wanopt/fullchain.pem --tls-key /etc/wanopt/privkey.pem --max-sessions 512 --max-lanes 8 --bulk-start-lanes 2 --metrics-listen 127.0.0.1:19090 --log-level info --json-logs
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wanopt /var/log/wanopt
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
